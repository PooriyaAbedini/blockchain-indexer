{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "outDir": "dist",
    "noErrorTruncation": true,
    "strict": true,
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "paths": {
      "#app/*": [
        "./src/*"
      ],
      "@goplus/sdk-node": [
        "./node_modules/@goplus/sdk-node/index.d.ts"
      ]
    },
    "typeRoots": [
      "./types",
      "node_modules/@types"
    ],
    "types": [
      "node",
      "jest"
    ],
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "strictNullChecks": true,
    "sourceMap": true,
    "inlineSources": true,
    "isolatedModules": false,
    "sourceRoot": "./src",
    "rootDir": "./src",
    "useDefineForClassFields": false,
    "incremental": false
  },
  "include": [
    "src/**/*",
    "types"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "api",
    "test"
  ],
  "ts-node": {
    "esm": true,
    "files": true,
    "require": [
      "tsconfig-paths/register"
    ],
    "transpileOnly": true,
    "experimentalSpecifierResolution": "node"
  }
}