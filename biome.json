{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "files": {
    "includes": [
      "src/**"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 85
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single"
    },
    "parser": {
      "unsafeParameterDecoratorsEnabled": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "style": {
        "noNonNullAssertion": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "noInvalidUseBeforeDeclaration": "error",
        "noUnreachable": "error"
      },
      "suspicious": {
        "noConsole": "error",
        "noFallthroughSwitchClause": "error",
        "noSelfCompare": "error",
        "noVar": "error"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": {
          "level": "off",
          "options": {
            "groups": [
              [
                ":NODE:",
                ":PACKAGE:",
                "!@app/**"
              ],
              [
                "@app/**",
                "!@app/utility/config/app.config"
              ],
              ":ALIAS:",
              ":PATH:"
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "src/shared-models/api/json-schema/**/*.ts",
        "src/shared-models/interfaces/**/*.d.ts",
        "src/database/generated/**"
      ],
      "linter": {
        "enabled": false
      },
      "assist": {
        "enabled": false
      },
      "formatter": {
        "enabled": false
      }
    },
    {
      "includes": [
        "src/api/v1/**/*.test.ts",
        "src/api/v1/**/*.spec.ts"
      ],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ]
}